# Kernel configuration of the vermeer image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
#
# Bring-up profile for the Redmi K70: the SM8550 SoC components below (UFS/AES/Adreno/ArchTimer)
# are the same as sheng. The verified-root chain of sheng is deliberately off: its block-storage
# bindings are qualified from a live-device observation (build/storage-abi/interface-audit.json,
# recorded from build/darwinboot-storage-native-metadata/gdb-stop.json), and its verified bundles
# need volume policies outside the repositories, so a clean CI checkout cannot reproduce them.
# BootProgress links native_virtio_*/native_owner_root_* directly, so it stays off with them.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# Off for the first boot: NativeUfs is compiled with -DNATIVE_VERIFIED_BLOCK=1 and its
# NativeUfsBlock subclasses IOBlockStorageDevice. That base class lives in Apple's
# IOStorageFamily, whose implementation only reaches the link through
# build/verified-root-xnu/libVerifiedRootProbe.a (scripts/build-os-root.py). With
# VERIFIED_ROOT_PROBE=n below, the final link ends with undefined
# IOBlockStorageDevice::* from libNativeUfs.a(NativeUfs.o). Keep the two in step:
# re-enable this only together with the verified-root chain, after the storage
# observation for this board exists. Without UFS the bring-up kernel has no block
# device and stops at "waiting for root device" on the console - which is exactly
# what the first boot is meant to show.
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
# Off: NativeAdrenoService.cpp only compiles with -Werror once build/sheng-gmu/ShengGmuSource.h
# exists, and prepare-sheng-gmu.py generates that header from SHA-pinned Linux a6xx sources plus the
# compiled sheng DTS. Neither is in a clean checkout, and the K70 GMU window (0x3d68000) differs from
# sheng's (0x3d6a000), so the sheng register set is not valid here. Re-enable together with a
# vermeer-specific GPU input set.
CONFIG_XNU_NATIVE_ADRENO=n

# Off until the live storage metadata observation is recorded on this device.
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_CACHE_STARTUP=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
CONFIG_XNU_BOOT_PROGRESS=n

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="18AB5557-DC2D-469B-8758-855E60F5B0DF"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
